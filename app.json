{
  "expo": {
    "name": "VION Vibracional",
    "slug": "vion-vibracional",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "vion",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#030308"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vion.vibracional",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "com.vion.vibracional",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#030308"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single-page",
      "favicon": "./assets/favicon.png",
      "name": "VION Vibracional",
      "shortName": "VION",
      "description": "Em que frequência vibras? Mapeia o teu nível de consciência.",
      "themeColor": "#7C5CFC",
      "backgroundColor": "#030308",
      "lang": "pt-PT"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#7C5CFC"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "revenueCatIosKey": "",
      "revenueCatAndroidKey": "",
      "stripePublishableKey": ""
    }
  }
}
